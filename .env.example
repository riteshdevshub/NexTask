# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE: MongoDB Atlas connection string.
# NexTask provides seamless local file persistence fallback if omitted in dev.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/nextask?retryWrites=true&w=majority"

# AUTH: JWT secrets for session authentication.
JWT_SECRET="nextask_super_secret_jwt_access_token_key_2026"
JWT_REFRESH_SECRET="nextask_super_secret_jwt_refresh_token_key_2026"

# EMAIL OTP: Resend API Key for sending verification & magic login emails.
# If omitted, on-screen dev OTP viewer displays the code in the UI for effortless testing.
RESEND_API_KEY="re_123456789_abcdefg"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# CLOUD STORAGE: Cloudinary credentials for media & file asset storage.
# NexTask includes an instant direct base64/blob storage fallback when unconfigured.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
